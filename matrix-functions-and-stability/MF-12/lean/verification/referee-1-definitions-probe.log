def NLA.MF12.productNorms : {d : Nat} → (M : Set.{0} (NLA.MF12.Mat d)) → (k : Nat) → Set.{0} Real :=
fun {d : Nat} (M : Set.{0} (NLA.MF12.Mat d)) (k : Nat) =>
  @Set.ofPred.{0} Real fun (t : Real) =>
    @Exists.{1} (Fin k → NLA.MF12.Mat d) fun (w : Fin k → NLA.MF12.Mat d) =>
      And
        (∀ (i : Fin k),
          @Membership.mem.{0, 0} (NLA.MF12.Mat d) (Set.{0} (NLA.MF12.Mat d)) (@Set.instMembership.{0} (NLA.MF12.Mat d))
            M (w i))
        (@Eq.{1} Real t
          (@Norm.norm.{0} (NLA.MF12.Mat d)
            (@NormedRing.toNorm.{0} (NLA.MF12.Mat d)
              (@Matrix.instL2OpNormedRing.{0, 0} Real (Fin d) Real.instRCLike (Fin.fintype d) (instDecidableEqFin d)))
            (@NLA.MF12.wordProduct d k w)))
def NLA.MF12.RealizesExponent : {d : Nat} → (M : Set.{0} (NLA.MF12.Mat d)) → (γ : Real) → Prop :=
fun {d : Nat} (M : Set.{0} (NLA.MF12.Mat d)) (γ : Real) =>
  And (@Set.Finite.{0} (NLA.MF12.Mat d) M)
    (And (@Set.Nonempty.{0} (NLA.MF12.Mat d) M)
