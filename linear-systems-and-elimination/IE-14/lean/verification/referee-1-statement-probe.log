def NLA.IE14.entryMax : {n : Nat} → (A : NLA.IE14.Mat n) → Real :=
fun {n : Nat} (A : NLA.IE14.Mat n) =>
  NNReal.toReal
    (@Finset.sup.{0, 0} NNReal (Prod.{0, 0} (Fin n) (Fin n)) NNReal.instSemilatticeSup NNReal.instOrderBot
      (@Finset.univ.{0} (Prod.{0, 0} (Fin n) (Fin n))
        (@instFintypeProd.{0, 0} (Fin n) (Fin n) (Fin.fintype n) (Fin.fintype n)))
      fun (ij : Prod.{0, 0} (Fin n) (Fin n)) =>
      @NNNorm.nnnorm.{0} Complex
        (@SeminormedAddGroup.toNNNorm.{0} Complex
          (@SeminormedAddCommGroup.toSeminormedAddGroup.{0} Complex
            (@NonUnitalSeminormedRing.toSeminormedAddCommGroup.{0} Complex
              (@NonUnitalSeminormedCommRing.toNonUnitalSeminormedRing.{0} Complex
                (@SeminormedCommRing.toNonUnitalSeminormedCommRing.{0} Complex
                  (@NormedCommRing.toSeminormedCommRing.{0} Complex
                    (@NormedField.toNormedCommRing.{0} Complex Complex.instNormedField)))))))
        (A (@Prod.fst.{0, 0} (Fin n) (Fin n) ij) (@Prod.snd.{0, 0} (Fin n) (Fin n) ij)))
def NLA.IE14.isPath : {n : ℕ} → NLA.IE14.Mat n → (ℕ → NLA.IE14.Mat n) → (Fin n → Fin n) → Prop :=
fun {n} A S r =>
  S 0 = A ∧
    ∀ (k : Fin n),
      k ≤ r k ∧
        S (↑k) (r k) k ≠ 0 ∧
          (∀ (i : Fin n), k ≤ i → ‖S (↑k) i k‖ ≤ ‖S (↑k) (r k) k‖) ∧
            (↑k + 1 < n → S (↑k + 1) = NLA.IE14.schurStep (S ↑k) k (r k))
def NLA.IE14.schurStep : {n : ℕ} → NLA.IE14.Mat n → Fin n → Fin n → NLA.IE14.Mat n :=
fun {n} A k r i j => if k < i ∧ k < j then A ((Equiv.swap k r) i) j - A ((Equiv.swap k r) i) k / A r k * A r j else 0
def NLA.IE14.cyclicGrowths : ℕ → Set ℝ :=
fun n => {t | ∃ A S r, NLA.IE14.IsCyclic A ∧ NLA.IE14.isPath A S r ∧ t = NLA.IE14.growth A S}
Matrix.isUnit_iff_isUnit_det.{u', v} {n : Type u'} {α : Type v} [Fintype n] [DecidableEq n] [CommRing α]
  (A : Matrix n n α) : IsUnit A ↔ IsUnit A.det
Finset.le_sup.{u_2, u_3} {α : Type u_2} {β : Type u_3} [SemilatticeSup α] [OrderBot α] {s : Finset β} {f : β → α}
  {b : β} (hb : b ∈ s) : f b ≤ s.sup f
IsLUB.csSup_eq.{u_1} {α : Type u_1} [ConditionallyCompleteLattice α] {s : Set α} {a : α} (H : IsLUB s a)
  (ne : s.Nonempty) : sSup s = a
